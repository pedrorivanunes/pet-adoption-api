{
  "info": {
    "name": "pet-adoption-api",
    "description": "The complete pet adoption API collection.\n\nBring the stack up with `docker compose up --build` -- the `demo` profile fills the database with a ready-made scenario.\n\nStart at **Authentication -> Login**: the token is saved automatically into a collection variable and used by every other request. Sample accounts (password `demo-password`):\n\n- `ana@example.com` -- ADMIN of Four Paws Shelter\n- `bruno@example.com` -- STAFF at the shelter\n- `carla@example.com` -- adopter with a pending application\n- `diego@example.com` -- adopter who already completed an adoption\n- `elisa@example.com` -- private guardian",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "ana@example.com" },
    { "key": "password", "value": "demo-password" },
    { "key": "petId", "value": "1" },
    { "key": "organizationId", "value": "1" },
    { "key": "applicationId", "value": "1" },
    { "key": "userId", "value": "2" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pessoa Nova\",\n  \"email\": \"nova@example.com\",\n  \"password\": \"a-very-secret-password\",\n  \"phone\": \"51999998888\"\n}"
            },
            "description": "Creates an account. Returns 409 if the email already exists, ignoring case."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login bem-sucedido', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.accessToken);",
                  "console.log('Token salvo. Expira em ' + body.expiresIn + 's.');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Authenticates and stores the token in the collection `token` variable. Change the `email` variable to act as someone else."
          }
        },
        {
          "name": "Login with wrong password (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"errada\"\n}" },
            "description": "Returns 401 as a ProblemDetail, with the same message a non-existent email gets -- it does not reveal which accounts exist."
          }
        },
        {
          "name": "My details",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
          }
        },
        {
          "name": "My pets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/me/pets", "host": ["{{baseUrl}}"], "path": ["api", "users", "me", "pets"] }
          }
        }
      ]
    },
    {
      "name": "Catalogue (public)",
      "item": [
        {
          "name": "List available pets",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pets?status=AVAILABLE&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pets"],
              "query": [
                { "key": "status", "value": "AVAILABLE" },
                { "key": "species", "value": "DOG", "disabled": true },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Public. Without the `status` parameter, it lists those available for adoption."
          }
        },
        {
          "name": "Pet detail",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}"] }
          }
        },
        {
          "name": "Traceability history",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}/history", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}", "history"] },
            "description": "Public. Individual guardians are not identified; organizations appear by name."
          }
        },
        {
          "name": "List organizations",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/organizations", "host": ["{{baseUrl}}"], "path": ["api", "organizations"] }
          }
        },
        {
          "name": "Pets of an organization",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/organizations/{{organizationId}}/pets", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{organizationId}}", "pets"] }
          }
        }
      ]
    },
    {
      "name": "Pets (management)",
      "item": [
        {
          "name": "Register own pet",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/pets", "host": ["{{baseUrl}}"], "path": ["api", "pets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pipoca\",\n  \"species\": \"dog\",\n  \"breed\": \"Vira-lata\",\n  \"sex\": \"FEMALE\",\n  \"size\": \"SMALL\",\n  \"birthDate\": \"2022-03-10\",\n  \"birthDateEstimated\": true,\n  \"goodWithOtherAnimals\": true,\n  \"healthNotes\": \"Vacinada e vermifugada\"\n}"
            },
            "description": "Without `ownerOrganizationId`, the owner is the authenticated person."
          }
        },
        {
          "name": "Register pet for the organization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/pets", "host": ["{{baseUrl}}"], "path": ["api", "pets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smoky\",\n  \"species\": \"cat\",\n  \"sex\": \"MALE\",\n  \"size\": \"MEDIUM\",\n  \"hasSpecialNeeds\": true,\n  \"requiresConstantCare\": true,\n  \"goodWithOtherAnimals\": false,\n  \"ownerOrganizationId\": {{organizationId}}\n}"
            },
            "description": "Requires membership of the organization -- 403 otherwise."
          }
        },
        {
          "name": "Update pet",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Luna\",\n  \"species\": \"dog\",\n  \"breed\": \"Vira-lata\",\n  \"sex\": \"FEMALE\",\n  \"size\": \"MEDIUM\",\n  \"status\": \"AVAILABLE\",\n  \"goodWithOtherAnimals\": true\n}"
            },
            "description": "The owner, or a member of the owning organization. Ownership does not change here."
          }
        },
        {
          "name": "Remove pet",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}"] },
            "description": "409 if the pet already has an adoption on record -- the history depends on it."
          }
        },
        {
          "name": "Record stay in the history",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}/history", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}", "history"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"FOSTER\",\n  \"location\": \"Foster home -- Cidade Baixa district\",\n  \"startedOn\": \"2025-11-01\",\n  \"notes\": \"Taken in by a volunteer until a place opened up\"\n}"
            },
            "description": "Automatically closes the previous stay on this one's start date."
          }
        },
        {
          "name": "Health record",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}/health-records", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}", "health-records"] },
            "description": "Restricted to whoever manages the animal -- it is not public."
          }
        },
        {
          "name": "Log health event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}/health-records", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}", "health-records"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"VACCINATION\",\n  \"occurredOn\": \"2026-06-01\",\n  \"description\": \"Rabies, annual dose\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "Create organization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/organizations", "host": ["{{baseUrl}}"], "path": ["api", "organizations"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Southside Paws\",\n  \"description\": \"Independent rescuers on the south side\",\n  \"email\": \"contact@southsidepaws.example.com\",\n  \"phone\": \"5133331111\",\n  \"address\": \"45 Example Street\"\n}"
            },
            "description": "The creator becomes ADMIN of the organization, in the same transaction."
          }
        },
        {
          "name": "Organization members",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/organizations/{{organizationId}}/members", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{organizationId}}", "members"] },
            "description": "Visible to members. 403 for outsiders."
          }
        },
        {
          "name": "Add member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/organizations/{{organizationId}}/members", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{organizationId}}", "members"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"elisa@example.com\",\n  \"role\": \"STAFF\"\n}" },
            "description": "ADMIN only. 409 if the person is already a member."
          }
        },
        {
          "name": "Change member role",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/organizations/{{organizationId}}/members/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{organizationId}}", "members", "{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"ADMIN\"\n}" },
            "description": "409 when demoting the last ADMIN -- the organization cannot be left headless."
          }
        },
        {
          "name": "Remove member",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/organizations/{{organizationId}}/members/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "organizations", "{{organizationId}}", "members", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Adoption",
      "item": [
        {
          "name": "Save adopter profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/me/adopter-profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "me", "adopter-profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"housingType\": \"HOUSE\",\n  \"hasChildren\": false,\n  \"residentsCount\": 2,\n  \"hasOtherPets\": false,\n  \"hasTimeAvailability\": true,\n  \"preferredSpecies\": \"dog\",\n  \"preferredSize\": \"MEDIUM\",\n  \"preferredSex\": \"FEMALE\",\n  \"acceptsSpecialNeeds\": false,\n  \"acceptsContinuousTreatment\": false,\n  \"acceptsChronicDisease\": false\n}"
            },
            "description": "Idempotent: creates on the first call, updates on the ones after."
          }
        },
        {
          "name": "I want to adopt (ranked)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/adoptions/matches", "host": ["{{baseUrl}}"], "path": ["api", "adoptions", "matches"] },
            "description": "Available pets ordered by compatibility, with the score broken down. Animals with a blocker do not appear. Log in as `carla@example.com` to see the ranking in action."
          }
        },
        {
          "name": "Apply",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('applicationId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/adoptions/applications", "host": ["{{baseUrl}}"], "path": ["api", "adoptions", "applications"] },
            "body": { "mode": "raw", "raw": "{\n  \"petId\": {{petId}},\n  \"message\": \"I have a fenced yard and I work from home.\"\n}" },
            "description": "409 when: there is no adopter profile, an application is already pending, the pet is not available, or you manage it yourself."
          }
        },
        {
          "name": "My applications",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/adoptions/applications/me", "host": ["{{baseUrl}}"], "path": ["api", "adoptions", "applications", "me"] }
          }
        },
        {
          "name": "Pet compatibility report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}/applications", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}", "applications"] },
            "description": "Applications ranked by affinity. Only for whoever manages the animal."
          }
        },
        {
          "name": "Approve application",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/adoptions/applications/{{applicationId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "adoptions", "applications", "{{applicationId}}", "approve"] },
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Perfil combina bem.\"\n}" },
            "description": "In one transaction: decides the application, transfers guardianship, records the adoption, opens the stay in the adoptive home and rejects the other applicants."
          }
        },
        {
          "name": "Reject application",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/adoptions/applications/{{applicationId}}/reject", "host": ["{{baseUrl}}"], "path": ["api", "adoptions", "applications", "{{applicationId}}", "reject"] },
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"We already have another applicant in advanced discussion.\"\n}" }
          }
        },
        {
          "name": "Withdraw application",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/adoptions/applications/{{applicationId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "adoptions", "applications", "{{applicationId}}", "cancel"] },
            "description": "The applicant's exclusive right. Frees the slot for another application."
          }
        }
      ]
    },
    {
      "name": "Post-adoption",
      "item": [
        {
          "name": "Log follow-up contact",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}/followups", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}", "followups"] },
            "body": { "mode": "raw", "raw": "{\n  \"kind\": \"VISIT\",\n  \"occurredOn\": \"2026-08-01\",\n  \"notes\": \"Animal bem adaptado, ganhou peso.\"\n}" },
            "description": "Belongs to whoever handed the animal over, never to whoever received it. Use `ana@example.com` with the pet Bidu."
          }
        },
        {
          "name": "Follow-up report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/pets/{{petId}}/followup-report", "host": ["{{baseUrl}}"], "path": ["api", "pets", "{{petId}}", "followup-report"] },
            "description": "The 6-month window, the contacts, the health events in the period, and the elapsed months without contact. Visible to whoever handed over and whoever adopted."
          }
        }
      ]
    },
    {
      "name": "Application health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        }
      ]
    }
  ]
}
